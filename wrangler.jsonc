{
  // Воркер раздаёт собранную статику. Имя должно совпадать с уже
  // существующим воркером, иначе деплой создаст второй.
  "name": "mathtasks",
  "compatibility_date": "2026-09-03",

  "assets": {
    "directory": "./dist",

    /* Маршрутизация живёт на клиенте, поэтому адреса вида /topic/<slug>
       файлам не соответствуют. Без этой строки Workers отдаёт на них 404,
       и ломаются прямой заход по ссылке и обычный F5.

       Собственный воркер с перехватом запросов для этого не нужен:
       Workers сам отдаёт index.html на навигационные запросы, которые
       не совпали ни с одним файлом. Настоящие файлы — /admin.html,
       /formulas/*.pdf, /assets/* — по-прежнему отдаются напрямую. */
    "not_found_handling": "single-page-application"
  }
}
