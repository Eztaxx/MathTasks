{
  // Воркер раздаёт собранную статику. Имя должно совпадать с уже
  // существующим воркером, иначе деплой создаст второй.
  "name": "mathtasks",
  "compatibility_date": "2026-09-03",

  // Воркер обслуживает карту сайта, превью задач, прокси к Gemini и дуэли.
  "main": "./worker/index.js",

  /* Счётчик частоты для /api/duel/start и /finish: не больше 20 запросов
     в минуту с одного адреса. Больше за минуту игры не набрать, а скрипт,
     засыпающий базу пустыми попытками, упрётся сразу. namespace_id — любое
     число, уникальное в пределах аккаунта Cloudflare. */
  "ratelimits": [
    { "name": "DUEL_LIMIT", "namespace_id": "2028", "simple": { "limit": 20, "period": 60 } }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    /* Весь трафик идёт через воркер. Списком известных префиксов обойтись
       нельзя: неизвестный адрес (/whatever-123) до воркера тогда не доходит,
       Cloudflare отдаёт оболочку приложения с кодом 200, и поисковик считает
       её копией главной — «мягкая 404». Файлы воркер отдаёт как есть, а
       /assets/* обслуживает отдельно: страница из прошлой выкладки, которая
       просит уже удалённый style-<старый хеш>.css, получает текущий, а не
       HTML-оболочку (иначе сайт открывался без стилей). */
    "run_worker_first": ["/*"],
    /* На страницах каталога воркер подставляет в index.html заголовок,
       описание, canonical и текстовую версию страницы (worker/seo.js):
       без этого поисковик видел на всех адресах одну пустую оболочку. */

    /* Маршрутизация живёт на клиенте, поэтому адреса вида /topic/<slug>
       файлам не соответствуют. Без этой строки Workers отдаёт на них 404,
       и ломаются прямой заход по ссылке и обычный F5.

       Перехватывать запросы в коде воркера для этого не нужно: Workers
       сам отдаёт index.html на навигационные запросы, которые не совпали
       ни с одним файлом. Настоящие файлы — /admin.html, /formulas/*.pdf,
       /assets/* — по-прежнему отдаются напрямую. */
    "not_found_handling": "single-page-application"
  }
}
