{
  "name": "math-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-config.js && vite build && node scripts/post-build.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:svgs": "node scripts/sync-svgs.js",
    "verify:answers": "node scripts/verify-answers.mjs",
    "verify:consistency": "node scripts/verify-consistency.mjs",
    "verify:parity": "node scripts/verify-formula-parity.mjs",
    "verify": "npm run verify:answers && npm run verify:consistency && npm run verify:pairing && npm run verify:parity",
    "verify:pairing": "node scripts/verify-language-pairing.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
