{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prod.mjs"],
            "timeout": 10,
            "statusMessage": "Проверка: выкладка, база, push"
          }
        ]
      }
    ]
  }
}
